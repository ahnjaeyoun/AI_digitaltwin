# Image registry. Include the trailing slash when a registry is used.
# Example: registry.example.com/digital-twin/
REGISTRY_PREFIX=
IMAGE_TAG=local

MOSQUITTO_IMAGE=eclipse-mosquitto:2.0
TIMESCALE_IMAGE=timescale/timescaledb-ha:pg18

TIMESCALE_DB=digital_twin
TIMESCALE_USER=digital_twin
TIMESCALE_PASSWORD=change-me
TIMESCALE_SCHEMA=public

# Used only by compose.local.yaml or compose.production.yaml.
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_HOST_PORT=1883
TIMESCALE_BIND_ADDRESS=127.0.0.1
TIMESCALE_HOST_PORT=6543

PRESS_LINE_NUMBER=7
PUBLISH_START_DELAY_SECONDS=5
PUBLISH_INTERVAL_SECONDS=1.0
PUBLISH_REPEAT=1
